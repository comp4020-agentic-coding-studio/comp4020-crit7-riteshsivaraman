---
// Shared page shell. Every page uses this + src/styles/anu.css tokens/classes.
import "../styles/anu.css";

interface Props {
  title: string;
  current?: "plan" | "graph";
}
const { title, current } = Astro.props;
const links = [
  { key: "plan", href: "/", label: "Plan" },
  { key: "graph", href: "/graph/", label: "Requisite graph" },
] as const;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | ANU Degree Planner</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__wordmark" href="/">ANU Degree Planner</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {links.map((l) => (
              <li>
                <a href={l.href} aria-current={current === l.key ? "page" : undefined}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        Student-built prototype, not an official ANU service. Requisite data is a static slice. <a href="/readme/">About</a>
      </div>
    </footer>
  </body>
</html>
