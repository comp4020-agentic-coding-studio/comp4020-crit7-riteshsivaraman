---
// The planner (PLAN.md §3.3, §4.3). Server-rendered: reads this browser's
// plan (dp_plan cookie → Astro.locals.planId, set by src/middleware.ts) and
// embeds only its catalogue neighbourhood for the Planner island. Runs
// server-only; reads no process.env itself.
import Planner from "../components/planner/Planner";
import Base from "../layouts/Base.astro";
import { getPlannerBootstrap } from "../lib/planner-state";
import "../styles/planner.css";

const bootstrap = getPlannerBootstrap(Astro.locals.planId);
const initialView = Astro.url.searchParams.get("view") === "graph" ? "graph" : "grid";
---

<Base title="Your degree plan" current="plan" scrapedAt={bootstrap.catalogueMeta.scrapedAt}>
  <div class="planner-head">
    <h1 class="planner-head__title">Your degree plan</h1>
    <p class="planner-head__lede">
      Place ANU courses semester by semester. The planner checks prerequisites, clashes and offerings as you go.
    </p>
  </div>
  <Planner client:load bootstrap={bootstrap} initialView={initialView} />
</Base>
