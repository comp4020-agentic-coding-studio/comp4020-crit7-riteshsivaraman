---
import Base from "../../layouts/Base.astro";
import { listCourses, listPlanEntries, listRequisiteNodes } from "../../lib/db";
import { layoutGraph, NODE_H, NODE_W, type EdgeStatus } from "../../lib/graph-layout";

const layout = layoutGraph(listCourses(), listRequisiteNodes(), listPlanEntries());
const pos = new Map(layout.nodes.map((n) => [n.code, n] as const));
const colour: Record<EdgeStatus, string> = {
  satisfied: "var(--status-satisfied)",
  pending: "var(--status-pending)",
  unmet: "var(--status-unmet)",
};
const edges = layout.edges.map((e) => {
  const a = pos.get(e.from)!;
  const b = pos.get(e.to)!;
  const x1 = a.x + NODE_W, y1 = a.y + NODE_H / 2, x2 = b.x, y2 = b.y + NODE_H / 2;
  return { ...e, x1, y1, x2, y2, mx: (x1 + x2) / 2, my: (y1 + y2) / 2 };
});
const planned = new Set(listPlanEntries().map((p) => p.courseCode));
---

<Base title="Requisite graph" current="graph">
  <h1 class="page-heading">Requisite graph</h1>
  <p>
    Arrows run from a prerequisite to the course that needs it. Edge colour reflects your current plan:
    <span class="badge badge-satisfied">satisfied</span>
    <span class="badge badge-pending">not planned</span>
    <span class="badge badge-unmet">unmet</span>
  </p>
  <div class="table-wrap">
    <svg
      width={layout.width}
      height={layout.height}
      viewBox={`0 0 ${layout.width} ${layout.height}`}
      role="img"
      aria-labelledby="graph-title"
    >
      <title id="graph-title">Course requisite dependency graph</title>
      {edges.map((e) => (
        <g data-edge={`${e.from}->${e.to}`} data-status={e.status}>
          <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke={colour[e.status]} stroke-width="3" />
          <circle cx={e.x2} cy={e.y2} r="4" fill={colour[e.status]} />
          {e.junction && (
            <text x={e.mx} y={e.my - 4} text-anchor="middle" font-size="11" fill="var(--color-text-muted)">
              {e.junction}
            </text>
          )}
        </g>
      ))}
      {layout.nodes.map((n) => (
        <g data-node={n.code}>
          <rect
            x={n.x}
            y={n.y}
            width={NODE_W}
            height={NODE_H}
            rx="2"
            fill={planned.has(n.code) ? "var(--anu-gold-tint)" : "var(--color-white)"}
            stroke="var(--anu-black)"
          />
          <text x={n.x + 8} y={n.y + 20} font-size="14" font-weight="700" fill="var(--color-text)">{n.code}</text>
          <text x={n.x + 8} y={n.y + 38} font-size="10" fill="var(--color-text-muted)">
            {n.title.length > 24 ? `${n.title.slice(0, 23)}…` : n.title}
          </text>
          {n.extraRules.length > 0 && (
            <text x={n.x + 8} y={n.y + 50} font-size="10" fill="var(--color-text-muted)">
              + {n.extraRules.join(", ")}
            </text>
          )}
        </g>
      ))}
    </svg>
  </div>
  <h2 class="section-heading">Edges</h2>
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Prerequisite</th><th>Course</th><th>Group</th><th>Status</th></tr></thead>
      <tbody>
        {layout.edges.map((e) => (
          <tr>
            <td>{e.from}</td><td>{e.to}</td><td>{e.junction ?? "-"}</td>
            <td><span class={`badge badge-${e.status}`}>{e.status === "pending" ? "not planned" : e.status}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
