---
// BRANCH-ONLY (PLAN.md §5.3 C): every primitive and state, for a real-browser
// check. Never a shipped route; deleted before merge.
import Base from "../layouts/Base.astro";
import KitDemo from "../components/ui/_kit/KitDemo";
const colours = ["ink","ink-2","muted","placeholder","canvas","surface","surface-2","line","line-strong","gold","gold-text","gold-wash","danger","danger-line","danger-wash","warn","warn-line","warn-wash","info","info-wash","edge-met","edge-unmet","edge-idle"];
const sizes = ["t-xs","t-sm","t-base","t-md","t-lg","t-xl"];
---
<Base title="UI kit">
  <style is:global>
    .kit-panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--shadow-1); padding: var(--s-5) var(--s-6); margin-top: var(--s-6); }
    .kit-panel h2 { font: 600 var(--t-md) var(--font-ui); margin-bottom: var(--s-3); }
    .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: var(--s-3); }
    .swatch { border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; font: 400 var(--t-xs) var(--font-code); }
    .swatch div { height: 40px; }
    .swatch span { display: block; padding: var(--s-1) var(--s-2); color: var(--ink-2); }
  </style>
  <h1>UI kit</h1>
  <p class="muted" style="margin-top: var(--s-2)">Track C primitives, every state. Branch-only page.</p>
  <section class="kit-panel" aria-labelledby="k-tok">
    <h2 id="k-tok">Tokens</h2>
    <div class="swatches">
      {colours.map((c) => <div class="swatch"><div style={`background: var(--${c})`}></div><span>--{c}</span></div>)}
    </div>
    <div style="margin-top: var(--s-5); display: grid; gap: var(--s-2)">
      {sizes.map((s) => <p style={`font: ${s === "t-xl" || s === "t-lg" ? 600 : 400} var(--${s}) var(--font-ui)`}><span class="code muted" style="font-size: 12px; display: inline-block; width: 72px">--{s}</span>Plan your degree one semester at a time</p>)}
      <p><span class="code" style="font-weight: 600">COMP2100 COMP2120 MATH1013 6u 12u</span> <span class="muted">— code face, tabular figures</span></p>
    </div>
  </section>
  <KitDemo client:load />
</Base>
